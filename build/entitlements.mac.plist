<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 🔑 THE MICROPHONE ENTITLEMENT IS THE WHOLE POINT OF THIS FILE. Hardened
       runtime is required for notarisation, and it BLOCKS microphone access
       unless the app declares it — so a notarised build without this line
       installs, launches, and then cannot take a call. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Electron's V8 needs both under hardened runtime; without them the app
       crashes on launch rather than degrading. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
