{
  "name": "bipli-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Bipli Desktop \u2014 your Bipli phone as an app that stays running.",
  "main": "src/main.js",
  "scripts": {
    "spike": "electron .",
    "check:load-failure": "node scripts/check-load-failure.js",
    "pack:win": "electron-builder --win --x64 --publish never",
    "pack:mac": "electron-builder --mac --publish never",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.bipli.desktop",
    "productName": "Bipli",
    "copyright": "Copyright \u00a9 2026 Bipli",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bipli",
        "repo": "bipli-desktop"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bipli",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    }
  },
  "author": {
    "name": "Bipli",
    "email": "sam@bipli.com"
  },
  "homepage": "https://bipli.com",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
